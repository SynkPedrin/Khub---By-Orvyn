{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "KHUB base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "target": "ES2021",
    "moduleResolution": "node"
  }
}
