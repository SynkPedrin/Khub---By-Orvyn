# Copie para .env (cp exemplo.env .env) e preencha. NUNCA versione o .env.

# Domínio do gateway (registro DNS tipo A apontando para o IP da VPS)
WA_DOMINIO=wa.SEU-DOMINIO

# --- obrigatórias (gere cada uma com: openssl rand -hex 32) ---
OPENWA_GATEWAY_KEY=COLE_AQUI_UMA_CHAVE_ALEATORIA
OPENWA_WEBHOOK_SECRET=COLE_AQUI_OUTRA_CHAVE_ALEATORIA
# Endereço do webhook na API do KHUB
KHUB_WEBHOOK_URL=https://api.SEU-DOMINIO/v1/webhooks/openwa

# --- opcionais ---
# Quantos números (sessões) este servidor aguenta ao mesmo tempo (~500 MB de RAM cada)
MAX_SESSOES=5
# Limite de memória do contêiner do gateway
GATEWAY_MEM_LIMIT=3g
# Licença open-wa (por número). Uma chave só, ou JSON por sessão:
# OPENWA_LICENSE_KEY={"khub-<uuid-do-cliente>":"CHAVE"}
OPENWA_LICENSE_KEY=
