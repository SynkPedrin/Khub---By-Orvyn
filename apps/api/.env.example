# ORVYN OS — API. Copie para .env (NUNCA commitar .env). Valores reais só no local do operador.
# Alvo de prontidão: com tudo preenchido EXCETO ANTHROPIC_API_KEY, a plataforma opera;
# só os endpoints da Nyro respondem 501 até a chave existir.

# ---- Core ----
PORT=3333
NODE_ENV=development
DATABASE_URL="postgresql://orvyn_app:CHANGE_ME@localhost:5432/orvyn?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- Auth (obrigatório: fatal no boot se faltar JWT_SECRET) ----
JWT_SECRET="troque-por-32+chars-fora-do-git"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30

# ---- IA da Nyro (última peça) ----
ANTHROPIC_API_KEY=          # liga chat/contextualizer/guardrails da Nyro (ausente => Nyro responde 501)
VOYAGE_API_KEY=             # opcional; ausente => retrieval cai para BM25 (busca lexical)

# ---- Cripto dos tokens OAuth por tenant (AES-256-GCM) ----
INTEGRATIONS_ENCRYPTION_KEY=   # 32 bytes em base64 (ex.: openssl rand -base64 32)

# ---- Meta (Facebook/Instagram Ads) — app do OPERADOR; token do cliente vem do OAuth ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# ---- Google Ads — Developer Token + OAuth2 (API key genérica NÃO serve) ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=

# ---- TikTok Ads ----
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ---- Stripe (billing do Orvyn + pagamentos no funil) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- WhatsApp (Evolution API) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- OAuth de login (opcional; ausente => botões Google/GitHub retornam 501) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=
