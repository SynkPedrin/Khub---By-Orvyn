# KHUB OS — API. Copie para .env (NUNCA commitar .env). Valores reais só no local do operador.
# Onde obter cada chave e o que cada uma destrava: docs/ENV.md (fonte única).
#
# Gating por credencial (Brief §2): TODO módulo já está implementado. Deixar uma
# variável vazia não quebra o boot nem some com a feature — só a chamada externa
# responde 501 config_required (ou degrada com fallback). Canário no CI:
# apps/api/src/config/config.service.spec.ts sobe com tudo de terceiro vazio.

# ---- Core ----
PORT=3333
NODE_ENV=development
DATABASE_URL="postgresql://khub_app:CHANGE_ME@localhost:5432/orvyn?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- Observabilidade (opcional — sem ela, só loga estruturado com correlation-id) ----
SENTRY_DSN=

# ---- Auth (obrigatório: fatal no boot se faltar JWT_SECRET) ----
JWT_SECRET="troque-por-32+chars-fora-do-git"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30

# ---- IA da Nyro (última peça) ----
ANTHROPIC_API_KEY=          # liga chat/contextualizer/guardrails da Nyro (ausente => Nyro responde 501)
VOYAGE_API_KEY=             # opcional; ausente => retrieval cai para BM25 (busca lexical)

# ---- Cripto dos tokens OAuth por tenant (AES-256-GCM) ----
INTEGRATIONS_ENCRYPTION_KEY=   # 32 bytes em base64 (ex.: openssl rand -base64 32)

# ---- Meta (Facebook/Instagram Ads) — app do OPERADOR; token do cliente vem do OAuth ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# ---- Google Ads — Developer Token + OAuth2 (API key genérica NÃO serve) ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_REDIRECT_URI=

# ---- TikTok Ads ----
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Conversas omnichannel (db/063): libera resposta por Instagram/Messenger/YouTube fora de produção
CANAIS_ENVIO_DEV=false

# ---- Stripe (billing do KHUB + pagamentos no funil) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Preço de cada plano da assinatura do PRÓPRIO KHUB (price_... da Stripe) —
# sem a chave daquele plano específico, só aquele plano não vende (os outros
# dois continuam normais). Ver docs/ENV.md §3.5 e PRD §17 (LACUNA de pricing).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---- WhatsApp (Evolution API) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- WhatsApp via Evolution API própria (CANAL_MVP — CLAUDE.md) ----
EVOLUTION_BASE_URL=         # ex.: http://127.0.0.1:8080 (Evolution self-hosted)
EVOLUTION_API_KEY=          # AUTHENTICATION_API_KEY do servidor Evolution (chave GLOBAL, não a de instância)
EVOLUTION_WEBHOOK_TOKEN=    # gerado por você (ex.: openssl rand -hex 24); vai na URL do webhook
EVOLUTION_WEBHOOK_URL=      # base que a Evolution consegue alcançar (Docker Desktop/Mac: http://host.docker.internal:3333)

# ---- WhatsApp via STEVO (legado — API não oficial, envio tipo SMS) ----
STEVO_API_URL=              # base da sua instância STEVO
STEVO_API_KEY=              # apikey/token da instância
STEVO_INSTANCE=             # id/nome da instância (se aplicável)
STEVO_SEND_PATH=/message/sendText   # ajustar conforme a doc do STEVO
STEVO_WEBHOOK_TOKEN=        # token opcional para validar o webhook de entrada
STEVO_FALLBACK_TENANT_ID=   # dev: tenant que recebe as mensagens de entrada
STEVO_TEST_NUMBER=          # dev: força o destino de TODO envio p/ este número (ex.: seu WhatsApp 5511999998888)

# ---- OAuth de login (opcional; ausente => botões Google/GitHub retornam 501) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=

# ---- E-mail transacional (convite de usuário) ----
# Ausente => o convite é criado e auditado, e o link de aceite volta na resposta
# para envio manual. Gmail: App Password (a chave AIzaSy... do painel NÃO envia).
SMTP_URL=                   # smtps://usuario:senha@smtp.gmail.com:465
SMTP_FROM=KHUB <no-reply@orvyn.app>

# ---- URL pública do front (redirect OAuth + link de convite) ----
WEB_URL=http://localhost:3210

# ---- Ajustes do RAG (todos com default; só preencha para calibrar) ----
RAG_TOPK_VECTOR=50
RAG_PRE_RERANK=30
RAG_TOPN_RERANK=8
RAG_RRF_K=60
RAG_MIN_SCORE=0.35
RAG_CACHE_TTL=3600
RAG_EMBED_BATCH=96
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIMS=1024            # mudar exige reindexar: a coluna é vector(1024)

# Resend: backend only; RESEND_FROM must use a verified domain.
RESEND_API_KEY=
RESEND_FROM=

# Número que recebe toda mensagem de TESTE de automação (botão Testar e modo
# simples da NICO). Vale também em produção: teste nunca fala com contato real.
# DDI + DDD + número, só dígitos. Vazio = teste não envia mensagem (só mostra).
AUTOMATION_TEST_PHONE=

# Disparo em massa (Q4.3). Opcionais: sem valor, valem os padrões abaixo.
# Audiência elegível acima disto exige aprovação de owner/admin (criado pela Nyro: sempre).
DISPAROS_APROVACAO_ACIMA=50
# Teto de envios por dia, por tenant e canal (protege o número de WhatsApp). O excedente segue no dia seguinte.
DISPAROS_LIMITE_DIARIO_WHATSAPP=300
DISPAROS_LIMITE_DIARIO_EMAIL=2000

# Firecrawl: pesquisa na web e leitura de páginas da NICO (benchmark). Sem a chave, a NICO avisa "conectar Firecrawl".
FIRECRAWL_API_KEY=
