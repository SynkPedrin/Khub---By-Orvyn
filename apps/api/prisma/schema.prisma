// Prisma como CLIENTE TIPADO. As migrações são SQL puro em db/*.sql
// (RLS/roles/pgvector não são geridos pelo Prisma Migrate). Não rodar
// `prisma migrate` contra este schema — usar `db/README.md`. R0.3.
// Fonte da verdade do schema: db/001_rag_schema.sql · Nyro IA/cerebro/Banco.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RagEscopo {
  global
  nicho
  sub
  tenant

  @@map("rag_escopo")
}

enum RagDocStatus {
  pending
  processing
  published
  failed
  superseded
  candidate

  @@map("rag_doc_status")
}

model Tenant {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome             String
  templateId       String?       @map("template_id")
  templateVersion  Int?          @map("template_version")
  nicho            String?
  subespecialidade String?
  endereco         String?
  telefone         String?
  website          String?
  idioma           String        @default("pt-BR")
  plano            String        @default("starter")
  status           String        @default("active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  documents        RagDocument[]

  @@map("tenants")
}

model RagDocument {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String?      @map("tenant_id") @db.Uuid
  escopo           RagEscopo
  nicho            String?
  subespecialidade String?
  titulo           String
  fonte            String
  uri              String?
  mime             String       @default("text/markdown")
  contentHash      String       @map("content_hash")
  versao           Int          @default(1)
  status           RagDocStatus @default(pending)
  erro             String?
  metadados        Json         @default("{}")
  criadoPor        String?      @map("criado_por") @db.Uuid
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks           RagChunk[]

  @@map("rag_documents")
}

model RagChunk {
  id               String                        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentId       String                        @map("document_id") @db.Uuid
  tenantId         String?                       @map("tenant_id") @db.Uuid
  escopo           RagEscopo
  nicho            String?
  subespecialidade String?
  ordem            Int
  breadcrumb       String?
  contexto         String?
  conteudo         String
  tokens           Int                           @default(0)
  embedding        Unsupported("vector(1024)")?
  embeddingModel   String                        @default("voyage-3-large") @map("embedding_model")
  status           RagDocStatus                  @default(published)
  metadados        Json                          @default("{}")
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  document         RagDocument                   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("rag_chunks")
}

model RagQuery {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  query          String
  queryReescrita String?  @map("query_reescrita")
  escopos        String[]
  chunkIds       String[] @map("chunk_ids") @db.Uuid
  scores         Float[]  @db.Real
  cacheHit       Boolean  @default(false) @map("cache_hit")
  latenciaMs     Int      @default(0) @map("latencia_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("rag_queries")
}

model RagFeedback {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  queryId        String?  @map("query_id") @db.Uuid
  resposta       String
  chunkIds       String[] @map("chunk_ids") @db.Uuid
  voto           Int      @db.SmallInt
  comentario     String?
  virouDocumento String?  @map("virou_documento") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("rag_feedback")
}

model NyroGuardrailHit {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nicho     String?
  regra     String
  trecho    String
  acao      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("nyro_guardrail_hits")
}

// ============================ CRM Core (F1) ============================

model User {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  identityId String?  @map("identity_id") @db.Uuid
  email      String
  nome       String
  role       String   @default("owner")
  permissoes Json     @default("{}")
  idioma     String   @default("pt-BR")
  prefs      Json     @default("{}")
  provider   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, email])
  @@map("users")
}

model Identity {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email           String
  passwordHash    String?   @map("password_hash")
  oauthProvider   String?   @map("oauth_provider")
  oauthSubject    String?   @map("oauth_subject")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  twofaSecret     String?   @map("twofa_secret")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("identities")
}

model Membership {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  role       String   @default("owner")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([identityId, tenantId])
  @@map("memberships")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  tenantId   String?   @map("tenant_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("refresh_tokens")
}

model Invite {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       String    @default("member")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("invites")
}

model AuditLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorType     String   @default("humano") @map("actor_type")
  actorId       String?  @map("actor_id")
  acao          String
  entidade      String?
  entidadeId    String?  @map("entidade_id")
  payload       Json     @default("{}")
  correlationId String?  @map("correlation_id")
  ts            DateTime @default(now()) @db.Timestamptz(6)

  @@map("audit_logs")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json      @default("{}")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Pipeline {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String
  tipo      String   @default("vendas")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  stages    Stage[]
  deals     Deal[]

  @@map("pipelines")
}

model Stage {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  nome       String
  ordem      Int
  cor        String   @default("#7B2FBE")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@map("stages")
}

model Contact {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  nome            String
  email           String?
  telefone        String?
  empresa         String?
  tag             String         @default("Lead")
  tags            String[]
  valorEstimado   Decimal        @default(0) @map("valor_estimado") @db.Decimal(12, 2)
  camposCustom    Json           @default("{}") @map("campos_custom")
  ultimoContatoAt DateTime?      @map("ultimo_contato_at") @db.Timestamptz(6)
  companyId       String?        @map("company_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals           Deal[]
  conversations   Conversation[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]

  @@map("contacts")
}

model Deal {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  titulo     String
  contactId  String?  @map("contact_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  stageId    String   @map("stage_id") @db.Uuid
  valor      Decimal  @default(0) @db.Decimal(12, 2)
  origem     String?
  status     String   @default("aberto")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tasks      Task[]
  notes      Note[]
  activities Activity[]

  @@map("deals")
}

model Conversation {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  contactId    String?   @map("contact_id") @db.Uuid
  nome         String
  canal        String    @default("WhatsApp")
  status       String    @default("aberta")
  ultimaPrevia String?   @map("ultima_previa")
  naoLidas     Int       @default(0) @map("nao_lidas")
  ultimaHora   String?   @map("ultima_hora")
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  autorTipo      String       @default("contato") @map("autor_tipo")
  corpo          String
  hora           String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Activity {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actor     String
  acao      String
  tone      String   @default("neutral")
  contactId String?  @map("contact_id") @db.Uuid
  dealId    String?  @map("deal_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ======================= CRM F2 (Sprint D1) =======================

model Company {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  nome         String
  dominio      String?
  telefone     String?
  endereco     String?
  segmento     String?
  tamanho      String?
  site         String?
  camposCustom Json      @default("{}") @map("campos_custom")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  contacts     Contact[]
  tasks        Task[]
  notes        Note[]

  @@map("companies")
}

model Task {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  titulo      String
  descricao   String?
  status      String    @default("aberta")
  prioridade  String    @default("media")
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  contactId   String?   @map("contact_id") @db.Uuid
  dealId      String?   @map("deal_id") @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Note {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  corpo      String
  contactId  String?  @map("contact_id") @db.Uuid
  dealId     String?  @map("deal_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  authorNome String?  @map("author_nome")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// ======================= Automações (Sprint E · migration 010) =======================

model Workflow {
  id            String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  nome          String
  descricao     String?
  tags          String[]          @default([])
  status        String            @default("rascunho")
  versaoAtivaId String?           @map("versao_ativa_id") @db.Uuid
  criadoPor     String?           @map("criado_por") @db.Uuid
  /// Configurações que evitam queimar a lista do cliente (migration 011)
  reentrada     String            @default("uma_vez")
  pararNoReply  Boolean           @default(false) @map("parar_no_reply")
  janelaAtiva   Boolean           @default(false) @map("janela_ativa")
  janelaDias    Int[]             @default([1, 2, 3, 4, 5]) @map("janela_dias")
  janelaInicio  Int               @default(9) @map("janela_inicio") @db.SmallInt
  janelaFim     Int               @default(18) @map("janela_fim") @db.SmallInt
  timezone      String            @default("America/Sao_Paulo")
  webhookKey    String?           @unique @map("webhook_key")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  versaoAtiva   WorkflowVersion?  @relation("versaoAtiva", fields: [versaoAtivaId], references: [id], onDelete: SetNull)
  versoes       WorkflowVersion[] @relation("versoesDoWorkflow")
  runs          WorkflowRun[]

  @@map("workflows")
}

/// Imutável depois de publicada: é o que dá rollback e mantém a espera de dias
/// terminando com a mesma lógica com que começou.
model WorkflowVersion {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  workflowId   String        @map("workflow_id") @db.Uuid
  versao       Int
  grafo        Json          @default("{\"nos\":[],\"arestas\":[]}")
  publicadoEm  DateTime?     @map("publicado_em") @db.Timestamptz(6)
  publicadoPor String?       @map("publicado_por") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  workflow     Workflow      @relation("versoesDoWorkflow", fields: [workflowId], references: [id], onDelete: Cascade)
  ativaEm      Workflow[]    @relation("versaoAtiva")
  runs         WorkflowRun[]

  @@unique([workflowId, versao])
  @@map("workflow_versions")
}

model WorkflowRun {
  id         String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  workflowId String            @map("workflow_id") @db.Uuid
  versionId  String            @map("version_id") @db.Uuid
  gatilho    String
  status     String            @default("rodando")
  noAtual    String?           @map("no_atual")
  estado     Json              @default("{}")
  contexto   Json              @default("{}")
  contactId  String?           @map("contact_id") @db.Uuid
  dealId     String?           @map("deal_id") @db.Uuid
  dedupeKey  String?           @map("dedupe_key")
  erro       String?
  passos     Int               @default(0)
  teste      Boolean           @default(false)
  startedAt  DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?         @map("finished_at") @db.Timestamptz(6)
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    WorkflowVersion   @relation(fields: [versionId], references: [id])
  steps      WorkflowRunStep[]

  @@map("workflow_runs")
}

/// Timeline nó-a-nó da execução (PRD §7.2).
model WorkflowRunStep {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  runId     String      @map("run_id") @db.Uuid
  noId      String      @map("no_id")
  tipo      String
  status    String
  tentativa Int         @default(1)
  entrada   Json        @default("{}")
  saida     Json        @default("{}")
  erro      String?
  duracaoMs Int?        @map("duracao_ms")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("workflow_run_steps")
}

/// Dead-letter: nó que esgotou o retry. Reprocessável sem perder o já feito.
model WorkflowDlq {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  noId        String    @map("no_id")
  tipo        String
  payload     Json      @default("{}")
  erro        String
  tentativas  Int       @default(0)
  resolvidoEm DateTime? @map("resolvido_em") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("workflow_dlq")
}

/// Drip mode (migration 015): contador por (tenant, nó, janela). O executor usa
/// UPSERT atômico via $queryRaw; este model documenta o schema e a RLS.
model WorkflowDripCounter {
  tenantId    String   @map("tenant_id") @db.Uuid
  nodeId      String   @map("node_id")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([tenantId, nodeId, windowStart])
  @@map("workflow_drip_counters")
}

/// Marketplace de templates de automação (migration 016). Global (tenantId null,
/// só orvyn_service publica) + do tenant. `workflow` é o grafo do editor.
model AutomationTemplate {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  slug         String
  name         String
  description  String   @default("")
  category     String
  subcategory  String?
  icon         String?
  segment      String?
  difficulty   String   @default("facil")
  estimatedMin Int?     @map("estimated_min")
  tags         String[] @default([])
  author       String   @default("Orvyn")
  version      Int      @default(1)
  isOfficial   Boolean  @default(false) @map("is_official")
  isPremium    Boolean  @default(false) @map("is_premium")
  isPublished  Boolean  @default(true) @map("is_published")
  featured     Boolean  @default(false)
  installs     Int      @default(0)
  rating       Decimal? @db.Decimal(3, 2)
  requirements String[] @default([])
  workflow     Json
  variables    Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("automation_templates")
}

// ======================= Configurações avançadas (migrations 018/019) =======================

