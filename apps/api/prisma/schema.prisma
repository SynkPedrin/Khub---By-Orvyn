// Prisma como CLIENTE TIPADO. As migrações são SQL puro em db/*.sql
// (RLS/roles/pgvector não são geridos pelo Prisma Migrate). Não rodar
// `prisma migrate` contra este schema — usar `db/README.md`. R0.3.
// Fonte da verdade do schema: db/001_rag_schema.sql · Nyro IA/cerebro/Banco.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RagEscopo {
  global
  nicho
  sub
  tenant

  @@map("rag_escopo")
}

enum RagDocStatus {
  pending
  processing
  published
  failed
  superseded
  candidate

  @@map("rag_doc_status")
}

model Tenant {
  settings         Json          @default("{}")
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome             String
  templateId       String?       @map("template_id")
  templateVersion  Int?          @map("template_version")
  nicho            String?
  subespecialidade String?
  endereco         String?
  telefone         String?
  website          String?
  idioma           String        @default("pt-BR")
  plano            String        @default("starter")
  status           String        @default("active")
  // `isDemo` existia no banco desde a migration 023 mas nunca tinha entrado
  // aqui (drift real, corrigido na migration 025 junto com os campos novos).
  isDemo           Boolean       @default(false) @map("is_demo")
  demoScenario     String?       @map("demo_scenario")
  datasetVersion   String?       @map("dataset_version")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  documents        RagDocument[]

  @@map("tenants")
}

model RagDocument {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String?      @map("tenant_id") @db.Uuid
  escopo           RagEscopo
  nicho            String?
  subespecialidade String?
  titulo           String
  fonte            String
  uri              String?
  mime             String       @default("text/markdown")
  contentHash      String       @map("content_hash")
  versao           Int          @default(1)
  status           RagDocStatus @default(pending)
  erro             String?
  metadados        Json         @default("{}")
  /// Texto extraído da fonte (reprocessar/visualizar) — db/034.
  textoFonte       String?      @map("texto_fonte")
  criadoPor        String?      @map("criado_por") @db.Uuid
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks           RagChunk[]

  @@map("rag_documents")
}

model RagChunk {
  id               String                        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentId       String                        @map("document_id") @db.Uuid
  tenantId         String?                       @map("tenant_id") @db.Uuid
  escopo           RagEscopo
  nicho            String?
  subespecialidade String?
  ordem            Int
  breadcrumb       String?
  contexto         String?
  conteudo         String
  tokens           Int                           @default(0)
  embedding        Unsupported("vector(1024)")?
  embeddingModel   String                        @default("voyage-3-large") @map("embedding_model")
  status           RagDocStatus                  @default(published)
  metadados        Json                          @default("{}")
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  document         RagDocument                   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("rag_chunks")
}

model RagQuery {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  query          String
  queryReescrita String?  @map("query_reescrita")
  escopos        String[]
  chunkIds       String[] @map("chunk_ids") @db.Uuid
  scores         Float[]  @db.Real
  cacheHit       Boolean  @default(false) @map("cache_hit")
  latenciaMs     Int      @default(0) @map("latencia_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("rag_queries")
}

model RagFeedback {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  queryId        String?  @map("query_id") @db.Uuid
  resposta       String
  chunkIds       String[] @map("chunk_ids") @db.Uuid
  voto           Int      @db.SmallInt
  comentario     String?
  virouDocumento String?  @map("virou_documento") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("rag_feedback")
}

model NyroGuardrailHit {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nicho     String?
  regra     String
  trecho    String
  acao      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("nyro_guardrail_hits")
}

// ============================ CRM Core (F1) ============================

model User {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  identityId String?  @map("identity_id") @db.Uuid
  email      String
  nome       String
  role       String   @default("owner")
  permissoes Json     @default("{}")
  idioma     String   @default("pt-BR")
  prefs      Json     @default("{}")
  provider   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, email])
  @@map("users")
}

model Identity {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email           String
  passwordHash    String?   @map("password_hash")
  oauthProvider   String?   @map("oauth_provider")
  oauthSubject    String?   @map("oauth_subject")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  twofaSecret     String?   @map("twofa_secret")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("identities")
}

model Membership {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  role       String   @default("owner")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([identityId, tenantId])
  @@map("memberships")
}

// ==================== Agency Mode (migration 026) ====================
// Globais, sem tenant_id próprio, sem RLS — mesmo padrão de Identity/
// Membership: descrevem a relação ENTRE tenants, não são dado de um tenant.

model Agency {
  settings         Json                  @default("{}")
  id               String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String
  slug             String                @unique
  ownerIdentityId  String                @map("owner_identity_id") @db.Uuid
  isDemo           Boolean               @default(false) @map("is_demo")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  members          AgencyMember[]
  clientAccounts   AgencyClientAccount[]

  @@map("agencies")
}

model AgencyInvite {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agencyId String @map("agency_id") @db.Uuid
  email String
  role String
  clientIds String[] @map("client_ids") @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("agency_invites")
}

model AgencyMember {
  id           String                          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agencyId     String                          @map("agency_id") @db.Uuid
  identityId   String                          @map("identity_id") @db.Uuid
  role         String                          @default("member")
  createdAt    DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  agency       Agency                          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientAccess AgencyMemberClientAccess[]
  clientPrefs  AgencyMemberClientPref[]

  @@unique([agencyId, identityId])
  @@map("agency_members")
}

model AgencyClientAccount {
  id          String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agencyId    String                     @map("agency_id") @db.Uuid
  tenantId    String                     @map("tenant_id") @db.Uuid
  displayName String                     @map("display_name")
  status      String                     @default("active")
  isDemo      Boolean                    @default(false) @map("is_demo")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  agency      Agency                     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberAccess AgencyMemberClientAccess[]
  memberPrefs  AgencyMemberClientPref[]

  @@unique([agencyId, tenantId])
  @@map("agency_client_accounts")
}

/// Preferências do membro por subconta no seletor (db/064): fixar e último acesso ("Recentes").
model AgencyMemberClientPref {
  agencyMemberId  String              @map("agency_member_id") @db.Uuid
  clientAccountId String              @map("client_account_id") @db.Uuid
  fixado          Boolean             @default(false)
  ultimoAcessoEm  DateTime?           @map("ultimo_acesso_em") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  member          AgencyMember        @relation(fields: [agencyMemberId], references: [id], onDelete: Cascade)
  clientAccount   AgencyClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@id([agencyMemberId, clientAccountId])
  @@map("agency_member_client_prefs")
}

model AgencyMemberClientAccess {
  id              String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agencyMemberId  String               @map("agency_member_id") @db.Uuid
  clientAccountId String               @map("client_account_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  member          AgencyMember         @relation(fields: [agencyMemberId], references: [id], onDelete: Cascade)
  clientAccount   AgencyClientAccount  @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([agencyMemberId, clientAccountId])
  @@map("agency_member_client_access")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  tenantId   String?   @map("tenant_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("refresh_tokens")
}

/// "Esqueci minha senha" (db/038 · ADR-0042). Infra de auth, sem RLS
/// (mesmo padrão de refresh_tokens). Guarda só o hash; uso único.
model PasswordResetToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_reset_tokens")
}

model Invite {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       String    @default("member")
  /// Acesso por módulo já escolhido no convite (db/065, ADR-0045): vira users.permissoes no aceite.
  permissoes Json      @default("{}")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("invites")
}

model AuditLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorType     String   @default("humano") @map("actor_type")
  actorId       String?  @map("actor_id")
  acao          String
  entidade      String?
  entidadeId    String?  @map("entidade_id")
  payload       Json     @default("{}")
  correlationId String?  @map("correlation_id")
  ts            DateTime @default(now()) @db.Timestamptz(6)

  @@map("audit_logs")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json      @default("{}")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Pipeline {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String
  tipo      String   @default("vendas")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  stages    Stage[]
  deals     Deal[]

  @@map("pipelines")
}

model Stage {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  nome       String
  ordem      Int
  cor        String   @default("#7B2FBE")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@map("stages")
}

model Contact {
  optedOutAt DateTime? @map("opted_out_at") @db.Timestamptz(6)
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamptz(6)
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  nome            String
  email           String?
  telefone        String?
  /// Foto de perfil do WhatsApp (db/037). URL assinada do pps.whatsapp.net —
  /// expira; `fotoEm` controla a revalidação por TTL.
  fotoUrl         String?         @map("foto_url")
  fotoEm          DateTime?       @map("foto_em") @db.Timestamptz(6)
  empresa         String?
  tag             String         @default("Lead")
  tags            String[]
  valorEstimado   Decimal        @default(0) @map("valor_estimado") @db.Decimal(12, 2)
  camposCustom    Json           @default("{}") @map("campos_custom")
  ultimoContatoAt DateTime?      @map("ultimo_contato_at") @db.Timestamptz(6)
  companyId       String?        @map("company_id") @db.Uuid
  // Colunas reais desde a migration 023 (drift real encontrado nesta
  // auditoria: existiam no Postgres, nunca tinham entrado no Prisma).
  score           Int?           @db.SmallInt
  scoreVersion    String?        @map("score_version")
  scoreAt         DateTime?      @map("score_at") @db.Timestamptz(6)
  scoreFatores    Json           @default("{}") @map("score_fatores")
  cargo           String?
  origem          String?
  localizacao     String?
  site            String?
  linkedin        String?
  /// Base legal/consentimento LGPD (RegrasNegocio §5). '{}' = não registrado
  /// ainda — nunca retroage um consentimento que não foi de fato dado.
  consentimento   Json           @default("{}")
  /// Origem do lead (db/066): { fonte, canal, adId, campanha, criativo, cliqueId, confianca, primeiroToqueEm, ultimoToque }.
  atribuicao      Json           @default("{}")
  ownerId         String?        @map("owner_id") @db.Uuid
  proximaAcaoAt   DateTime?      @map("proxima_acao_at") @db.Timestamptz(6)
  proximaAcaoTipo String?        @map("proxima_acao_tipo")
  // Atribuição real (migration 025): de qual campanha/criativo este contato
  // nasceu. Sem FK aqui, Analytics não tem como responder "que receita veio
  // deste criativo?" sem inventar a resposta.
  adCampaignId    String?        @map("ad_campaign_id") @db.Uuid
  adCreativeId    String?        @map("ad_creative_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals           Deal[]
  conversations   Conversation[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]

  @@map("contacts")
}

/// Lista salva (smart list) de Leads/Contatos (db/052 · Q2.2). Filtros e
/// colunas validados na API (crm/contatos-filtro.ts). Do dono; compartilhada
/// = visível à equipe do mesmo tenant (RLS).
model ContactView {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  nome            String
  filtros         Json     @default("{}")
  colunas         Json     @default("[]")
  ordem           String   @default("recentes")
  ownerIdentityId String   @map("owner_identity_id") @db.Uuid
  compartilhada   Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("contact_views")
}

model Deal {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  titulo     String
  contactId  String?  @map("contact_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  stageId    String   @map("stage_id") @db.Uuid
  valor      Decimal  @default(0) @db.Decimal(12, 2)
  origem     String?
  status     String   @default("aberto")
  /// Valores dos campos personalizados do negócio (db/053). Definições em CustomFieldDef.
  camposCustom Json   @default("{}") @map("campos_custom")
  /// Motivo de perda (db/051 · Q2.1): obrigatório pela API ao marcar perdido se o tenant tem motivos ativos.
  motivoPerdaId  String? @map("motivo_perda_id") @db.Uuid
  motivoPerdaObs String? @map("motivo_perda_obs")
  /// identities.id do responsável (db/051). Sem FK: a API valida que é membro do tenant.
  ownerId    String?  @map("owner_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  motivoPerda LostReason? @relation(fields: [motivoPerdaId], references: [id], onDelete: SetNull)
  tasks      Task[]
  notes      Note[]
  activities Activity[]

  @@map("deals")
}

/// Catálogo de motivos de perda por tenant (db/051 · Q2.1). RLS tenant_rw.
model LostReason {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  deals     Deal[]

  @@index([tenantId, ordem], map: "idx_lost_reasons_lista")
  @@map("lost_reasons")
}

model Conversation {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  contactId    String?   @map("contact_id") @db.Uuid
  nome         String
  canal        String    @default("WhatsApp")
  status       String    @default("aberta")
  ultimaPrevia String?   @map("ultima_previa")
  naoLidas     Int       @default(0) @map("nao_lidas")
  ultimaHora   String?   @map("ultima_hora")
  /// Quem responde agora: 'ia' (agente) ou 'humano' (db/030 · ADR-0030).
  atendimento   String    @default("humano")
  agentId       String?   @map("agent_id") @db.Uuid
  /// identities.id do humano responsável (validado como membro do tenant na API).
  assigneeId    String?   @map("assignee_id") @db.Uuid
  handoffMotivo String?   @map("handoff_motivo")
  handoffAt     DateTime? @map("handoff_at") @db.Timestamptz(6)
  /// 'dm' | 'comentario' (db/063): comentário de post/anúncio/vídeo também é conversa.
  tipo            String    @default("dm")
  /// Id da conversa NA REDE (IGSID/PSID da DM, id do comentário raiz). Único por (tenant, canal).
  externoId       String?   @map("externo_id")
  canalConexaoId  String?   @map("canal_conexao_id") @db.Uuid
  /// De onde veio o comentário (post/mídia/vídeo). Nunca token.
  contextoExterno Json?     @map("contexto_externo")
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@map("conversations")
}

/// Conta de rede conectada pelo tenant dentro de Conversas (db/063):
/// Instagram/Messenger (página do Facebook), YouTube (canal). O WhatsApp
/// continua em `integrations` (Stevo/Evolution). Token só cifrado.
model ChannelConnection {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  rede                 String
  externalId           String    @map("external_id")
  pageId               String?   @map("page_id")
  nome                 String    @default("")
