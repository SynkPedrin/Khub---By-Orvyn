/// Imutável depois de publicada: é o que dá rollback e mantém a espera de dias
/// terminando com a mesma lógica com que começou.
model WorkflowVersion {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  workflowId   String        @map("workflow_id") @db.Uuid
  versao       Int
  grafo        Json          @default("{\"nos\":[],\"arestas\":[]}")
  publicadoEm  DateTime?     @map("publicado_em") @db.Timestamptz(6)
  publicadoPor String?       @map("publicado_por") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  workflow     Workflow      @relation("versoesDoWorkflow", fields: [workflowId], references: [id], onDelete: Cascade)
  ativaEm      Workflow[]    @relation("versaoAtiva")
  runs         WorkflowRun[]

  @@unique([workflowId, versao])
  @@map("workflow_versions")
}

model WorkflowRun {
