model RedesPublicacao {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  conexaoId            String    @map("conexao_id") @db.Uuid
  rede                 String
  formato              String
  titulo               String?
  legenda              String    @default("")
  midiaUrl             String    @map("midia_url")
  privacidade          String?
  opcoes               Json      @default("{}")
  agendadoPara         DateTime  @map("agendado_para") @db.Timestamptz(6)
  status               String    @default("agendado")
  tentativas           Int       @default(0)
  externoId            String?   @map("externo_id")
  postId               String?   @map("post_id")
  permalink            String?
  erro                 String?
  proximaVerificacaoEm DateTime? @map("proxima_verificacao_em") @db.Timestamptz(6)
  publicadoEm          DateTime? @map("publicado_em") @db.Timestamptz(6)
  confirmadoPor        String?   @map("confirmado_por") @db.Uuid
  confirmadoEm         DateTime  @map("confirmado_em") @db.Timestamptz(6)
  criadoPor            String?   @map("criado_por") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_redes_pub_tenant")
  @@map("redes_publicacoes")
}

/// Foto diária da conta de rede social (db/068): base do gráfico de crescimento.
model RedesSnapshot {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  conexaoId     String   @map("conexao_id") @db.Uuid
  rede          String
  dia           DateTime @db.Date
  seguidores    BigInt?
  publicacoes   BigInt?
  visualizacoes BigInt?
  curtidas      BigInt?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([conexaoId, dia], map: "redes_snap_dia_uq")
  @@map("redes_snapshots")
}


// ==================== Catálogo, estoque e importações (db/071) ====================
/// Cada lote importado (Avec etc.): auditar e desfazer o lote inteiro.
model Importacao {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  fonte        String    @default("avec")
  /// clientes|agenda|financeiro|servicos|profissionais|estoque|comissoes
  entidade     String
  arquivoNome  String?   @map("arquivo_nome")
  linhasTotal  Int       @default(0) @map("linhas_total")
  criados      Int       @default(0)
  atualizados  Int       @default(0)
  ignorados    Int       @default(0)
  erros        Int       @default(0)
  /// concluida|desfeita
  status       String    @default("concluida")
  resumo       Json      @default("{}")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  desfeitaEm   DateTime? @map("desfeita_em") @db.Timestamptz(6)

  @@map("importacoes")
}

/// Quem atende e recebe comissão. NÃO é usuário do sistema (vínculo opcional).
model Profissional {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  nome            String
  especialidade   String?
  comissaoPercent Decimal  @default(0) @map("comissao_percent") @db.Decimal(5, 2)
  email           String?
  telefone        String?
  identityId      String?  @map("identity_id") @db.Uuid
  ativo           Boolean  @default(true)
  importacaoId    String?  @map("importacao_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profissionais")
}

model Servico {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  nome            String
  categoria       String?
  duracaoMin      Int      @default(30) @map("duracao_min")
  precoCentavos   Int      @default(0) @map("preco_centavos")
  /// NULL = usa a comissão padrão do profissional.
  comissaoPercent Decimal? @map("comissao_percent") @db.Decimal(5, 2)
  ativo           Boolean  @default(true)
  importacaoId    String?  @map("importacao_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("servicos")
}

model Produto {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nome          String
  sku           String?
  categoria     String?
  unidade       String   @default("un")
  custoCentavos Int      @default(0) @map("custo_centavos")
  precoCentavos Int      @default(0) @map("preco_centavos")
  estoqueMinimo Decimal  @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  ativo         Boolean  @default(true)
  importacaoId  String?  @map("importacao_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("produtos")
}

/// Razão do estoque: `delta` com sinal (entrada +, saída −). Saldo = SUM(delta).
model EstoqueMovimento {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  produtoId       String   @map("produto_id") @db.Uuid
  /// entrada|saida|ajuste
  tipo            String
  delta           Decimal  @db.Decimal(12, 3)
  custoCentavos   Int?     @map("custo_centavos")
  motivo          String?
  dataMovimento   DateTime @default(now()) @map("data_movimento") @db.Date
  /// manual|importacao
  origem          String   @default("manual")
  chaveImportacao String?  @map("chave_importacao")
  importacaoId    String?  @map("importacao_id") @db.Uuid
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("estoque_movimentos")
}
