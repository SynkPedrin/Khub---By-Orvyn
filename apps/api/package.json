{
  "name": "@orvyn/api",
  "version": "0.0.1",
  "private": true,
  "description": "Orvyn API — NestJS (monólito modular) + Prisma/pgvector.",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../../db/000_foundation.sql -f ../../db/001_rag_schema.sql -f ../../db/001a_rls_harden.sql",
    "db:isolation-test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../../db/002_isolation_test.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@orvyn/types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@orvyn/types$": "<rootDir>/../../../packages/types/src/index.ts"
    }
  }
}
